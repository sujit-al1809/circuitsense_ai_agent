# CircuitSense backend configuration. Copy to backend/.env and adjust.
# Never commit real credentials. Use either a Bedrock API key (below) or the standard AWS
# credential chain (environment, ~/.aws profile, SSO, or an IAM role).

# ---------------------------------------------------------------- provider
# demo    = deterministic rule-based agent, no AWS calls, clearly labelled in the UI
# bedrock = Amazon Bedrock Converse API for vision + reasoning
PROVIDER_MODE=demo

# Required when PROVIDER_MODE=bedrock
AWS_REGION=us-east-1
# Model or inference-profile IDs available to YOUR account in AWS_REGION. Find them with:
#   aws bedrock list-foundation-models --region us-east-1 --by-output-modality TEXT
#   aws bedrock list-inference-profiles --region us-east-1
# The text model must support tool use (Converse API); the vision model must accept IMAGE input.
# Many newer models are only invocable through a cross-region inference profile (e.g. an ID starting with "us.").
# Example (Amazon Nova): text/agent = Nova 2 Lite, vision = Nova Pro
BEDROCK_TEXT_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_VISION_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=4096
# Nova: 0 (greedy) is recommended for tool calling. Leave unset for models that reject sampling params.
BEDROCK_TEMPERATURE=0

# Optional Bedrock API key (Bedrock console -> API keys). A value here overrides an older
# AWS_BEARER_TOKEN_BEDROCK inherited from the OS environment. Otherwise the standard AWS
# credential chain (profile, SSO, IAM role) is used.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_READ_TIMEOUT_S=120

# ---------------------------------------------------------------- agent limits
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS_PER_ITERATION=4
AGENT_MAX_TOOL_FAILURES=3
AGENT_HISTORY_TURNS=6

# ---------------------------------------------------------------- uploads & sessions
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
SESSION_MAX_COUNT=100

# Optional: archive original uploads to S3 (SSE-S3 encrypted). Leave empty to disable.
S3_BUCKET=
S3_PREFIX=circuitsense/uploads

# ---------------------------------------------------------------- simulation (optional)
# Path to the ngspice executable. If unset, "ngspice" is looked up on PATH.
# NGSPICE_PATH=
SIMULATION_TIMEOUT_S=10

# ---------------------------------------------------------------- web
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve the built frontend from the API (single-container deployment):
# FRONTEND_DIST=../frontend/dist
