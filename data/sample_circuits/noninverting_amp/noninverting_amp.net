(export (version "E")
  (design
    (source "noninverting_amp.kicad_sch")
    (date "2026-10-10")
    (tool "CircuitSense reference netlist (hand-authored in KiCad netlist format; not exported from Eeschema)"))
  (components
    (comp (ref "V1")
      (value "0.1V")
      (description "DC input signal source")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source"))
      (property (name "CS_Type") (value "voltage_source")))
    (comp (ref "V2")
      (value "12V")
      (description "Positive supply rail")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source"))
      (property (name "CS_Type") (value "voltage_source")))
    (comp (ref "V3")
      (value "12V")
      (description "Negative supply rail (positive terminal to GND)")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source"))
      (property (name "CS_Type") (value "voltage_source")))
    (comp (ref "U1")
      (value "Generic op-amp")
      (description "General-purpose single op-amp, standard 8-pin single op-amp pinout")
      (libsource (lib "Amplifier_Operational") (part "Opamp_Generic_8pin") (description "Generic operational amplifier"))
      (property (name "CS_Type") (value "opamp")))
    (comp (ref "R1")
      (value "1k")
      (description "Gain-setting resistor, 1%")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2")
      (value "10k")
      (description "Feedback resistor, 1%")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R3")
      (value "10k")
      (description "Load resistor, 1%")
      (libsource (lib "Device") (part "R") (description "Resistor"))))
  (nets
    (net (code "1") (name "VIN")
      (node (ref "V1") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "U1") (pin "3") (pinfunction "IN+") (pintype "input")))
    (net (code "2") (name "FB")
      (node (ref "U1") (pin "2") (pinfunction "IN-") (pintype "input"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive")))
    (net (code "3") (name "VOUT")
      (node (ref "U1") (pin "6") (pinfunction "OUT") (pintype "output"))
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "R3") (pin "1") (pintype "passive")))
    (net (code "4") (name "VCC")
      (node (ref "V2") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "U1") (pin "7") (pinfunction "V+") (pintype "power_in")))
    (net (code "5") (name "VEE")
      (node (ref "V3") (pin "2") (pinfunction "-") (pintype "passive"))
      (node (ref "U1") (pin "4") (pinfunction "V-") (pintype "power_in")))
    (net (code "6") (name "GND")
      (node (ref "V1") (pin "2") (pinfunction "-") (pintype "passive"))
      (node (ref "V2") (pin "2") (pinfunction "-") (pintype "passive"))
      (node (ref "V3") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "R3") (pin "2") (pintype "passive")))))
