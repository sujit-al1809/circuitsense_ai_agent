(export (version "E")
  (design
    (source "led_basic.kicad_sch")
    (date "2026-10-10")
    (tool "CircuitSense reference netlist (hand-authored in KiCad netlist format; not exported from Eeschema)"))
  (components
    (comp (ref "V1")
      (value "5V")
      (description "DC voltage source")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source"))
      (property (name "CS_Type") (value "voltage_source")))
    (comp (ref "R1")
      (value "330")
      (description "Resistor, carbon film, 5%")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "D1")
      (value "Red LED")
      (description "Indicator LED, 5 mm, red")
      (libsource (lib "Device") (part "LED") (description "Light emitting diode"))))
  (nets
    (net (code "1") (name "VCC")
      (node (ref "V1") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive")))
    (net (code "2") (name "LED_A")
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive")))
    (net (code "3") (name "GND")
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
      (node (ref "V1") (pin "2") (pinfunction "-") (pintype "passive")))))
