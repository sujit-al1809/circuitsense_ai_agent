(export (version "E")
  (design
    (source "resistor_divider.kicad_sch")
    (date "2026-10-10")
    (tool "CircuitSense reference netlist (hand-authored in KiCad netlist format; not exported from Eeschema)"))
  (components
    (comp (ref "V1")
      (value "12V")
      (description "DC voltage source")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "DC voltage source"))
      (property (name "CS_Type") (value "voltage_source")))
    (comp (ref "R1")
      (value "10k")
      (description "Resistor, 1%")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2")
      (value "4.7k")
      (description "Resistor, 1%")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "J1")
      (value "Output")
      (description "2-pin output header")
      (libsource (lib "Connector") (part "Conn_01x02") (description "Generic connector, single row, 01x02"))))
  (nets
    (net (code "1") (name "VIN")
      (node (ref "V1") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive")))
    (net (code "2") (name "VOUT")
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive"))
      (node (ref "J1") (pin "1") (pinfunction "Pin_1") (pintype "passive")))
    (net (code "3") (name "GND")
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "J1") (pin "2") (pinfunction "Pin_2") (pintype "passive"))
      (node (ref "V1") (pin "2") (pinfunction "-") (pintype "passive")))))
